<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="udala.tramiteak"
    >

  <!-- -*- extra stuff goes here -*- -->
  <include package="plone.app.contentmenu" />

  <browser:page
      name="procedures_view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".procedures_view.ProceduresView"
      template="procedures_view.pt"
      permission="zope2.View"
      layer="udala.tramiteak.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="Procedures view"
      />

  <browser:page
      name="grants_view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".grants_view.GrantsView"
      template="grants_view.pt"
      permission="zope2.View"
      layer="udala.tramiteak.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="Grants view"
      />

  <browser:page
      name="view"
      for="udala.tramiteak.content.procedure.IProcedure"
      class=".procedure_view.ProcedureView"
      template="procedure_view.pt"
      permission="zope2.View"
      layer="udala.tramiteak.interfaces.IBrowserLayer"
      />

  <browser:page
      name="view"
      for="udala.tramiteak.content.grant.IGrant"
      class=".grant_view.GrantView"
      template="grant_view.pt"
      permission="zope2.View"
      layer="udala.tramiteak.interfaces.IBrowserLayer"
      />



</configure>
