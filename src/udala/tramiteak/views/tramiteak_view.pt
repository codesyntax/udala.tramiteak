<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.tramiteak"
>

  <body>

    <metal:custom_title fill-slot="content-title">
      <h1 tal:replace="structure context/@@title"></h1>

      <!-- @@title view template: -->
      <!--
    <h1 tal:define="title context/Title" tal:condition="title" tal:content="title">
      Title or id
    </h1>
    -->

    </metal:custom_title>

    <metal:custom_description fill-slot="content-description">
      <p tal:replace="structure context/@@description"></p>
    </metal:custom_description>

    <metal:content-core fill-slot="content-core">

      <div class="accordion"
           id="accordionExample"
      >
        <div class="accordion-item"
             tal:repeat="de view/tramiteak"
        >
          <h2 class="accordion-header">
            <button class="accordion-button collapsed"
                    aria-controls="collapseOne"
                    aria-expanded="false"
                    type="button"
                    data-bs-target="#collapseOne"
                    data-bs-toggle="collapse"
                    tal:content="de/Title"
                    tal:attributes="
                      data-bs-target string:#collapse${repeat/de/index};
                      aria-controls string:collapse${repeat/de/index};
                    "
            >
            </button>
          </h2>
          <div class="accordion-collapse collapse"
               data-bs-parent="#accordionTramiteak"
               tal:attributes="
                 id string:collapse${repeat/de/index};
               "
          >
            <div class="accordion-body">
              <ul class="list-group">
                <li class="list-group-item"
                    tal:repeat="tr de/tramiteak"
                >
                  <tal:items condition="python:tr.bulegoan or tr.telefonoz or tr.online">
                    <span class="badge bulegoan"
                          title="Egin tramitea Bulegoan"
                          tal:condition="tr/bulegoan"
                          i18n:attributes="title"
                    >
                      <span class="text-hide"
                            i18n:translate=""
                      >
                      Egin tramitea Bulegoan
                      </span>
                    </span>
                    <span class="badge phone"
                          title="Egin tramitea telefonoz"
                          tal:condition="tr/telefonoz"
                          i18n:attributes="title"
                    >
                      <span class="text-hide">
                      Egin tramitea telefonoz
                      </span>
                    </span>
                    <span class="badge online"
                          title="Do this tramitation online"
                          tal:condition="tr/online"
                          i18n:attributes="title"
                    >
                      <span class="text-hide"
                            i18n:translate="label_do_it_online"
                      >
                      Do this tramitation online
                      </span>
                    </span>
                  </tal:items>
                  <a href=""
                     tal:content="tr/Title"
                     tal:attributes="
                       href tr/absolute_url;
                     "
                  >
                  Title
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </metal:content-core>
  </body>

</html>
