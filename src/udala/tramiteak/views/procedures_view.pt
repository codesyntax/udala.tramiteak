<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.Procedurek"
>

  <body>

    <metal:content-core fill-slot="content-core">

      <div class="accordion shadow-sm mb-5"
           id="procedures-accordion"
           tal:define="
             icons python:context.restrictedTraverse('@@iconresolver');
             folder_brains python:context.restrictedTraverse('@@contentlisting')(portal_type='Folder');
           "
      >
        <div class="accordion-item"
             tal:repeat="folder_brain folder_brains"
        >
          <tal:items define="
                       folder python:folder_brain.getObject();
                     ">
            <h2 class="accordion-header m-0">
              <button class="accordion-button collapsed fw-bold fs-5"
                      aria-controls="collapseOne"
                      aria-expanded="false"
                      type="button"
                      data-bs-target="#collapseOne"
                      data-bs-toggle="collapse"
                      tal:content="folder/Title"
                      tal:attributes="
                        data-bs-target string:#collapse${repeat/folder_brain/index};
                        aria-controls string:collapse${repeat/folder_brain/index};
                      "
              >
              </button>
            </h2>
            <div class="accordion-collapse collapse"
                 data-bs-parent="#procedures-accordion"
                 tal:attributes="
                   id string:collapse${repeat/folder_brain/index};
                 "
            >
              <div class="accordion-body p-0"
                   tal:define="
                     procedure_brains python:folder.restrictedTraverse('@@contentlisting')(portal_type=['Procedure', 'Grant']);
                   "
              >
                <ul class="list-group list-group-flush">
                  <li class="list-group-item list-group-item-action d-flex p-0 align-items-center border-0 border-bottom"
                      tal:repeat="procedure_brain procedure_brains"
                  >
                    <tal:item define="
                                procedure python:procedure_brain.getObject();
                              ">
                      <a class="p-3 flex-grow-1 text-decoration-none fw-medium text-dark"
                         href=""
                         tal:content="procedure/Title"
                         tal:attributes="
                           href procedure/absolute_url;
                         "
                      >
                      Title
                      </a>
                      <div class="procedure-mode p-3 d-flex gap-3 bg-light bg-opacity-50"
                           tal:condition="python:procedure.at_office or procedure.by_phone or procedure.online_url"
                      >

                        <span title="At the citizen office"
                              tal:condition="procedure/at_office"
                              tal:replace="structure python:icons.tag('info-circle', tag_class='text-primary fs-5', tag_alt='Do this procedure at the citizen office')"
                        ></span>

                        <span title="By phone"
                              tal:condition="procedure/by_phone"
                              tal:replace="structure python:icons.tag('telephone', tag_class='text-primary fs-5', tag_alt='Do this procedure by phone')"
                        ></span>

                        <span title="Online"
                              tal:condition="procedure/online_url"
                              tal:replace="structure python:icons.tag('globe', tag_class='text-primary fs-5', tag_alt='Do this procedure online')"
                        ></span>

                      </div>
                    </tal:item>
                  </li>

                </ul>
              </div>
            </div>
          </tal:items>
        </div>
      </div>

      <div class="card shadow-sm border-0"
           id="other-procedures"
           tal:define="
             icons python:context.restrictedTraverse('@@iconresolver');
             procedure_brains python:context.restrictedTraverse('@@contentlisting')(portal_type=['Procedure', 'Grant']);
           "
           tal:condition="procedure_brains"
      >
        <div class="card-body p-0">
          <ul class="list-group list-group-flush rounded border">
            <li class="list-group-item list-group-item-action d-flex p-0 align-items-center border-0 border-bottom"
                tal:repeat="procedure_brain procedure_brains"
            >
              <tal:item define="
                          procedure python:procedure_brain.getObject();
                        ">
                <a class="p-3 flex-grow-1 text-decoration-none fw-medium text-dark"
                   href=""
                   tal:content="procedure/Title"
                   tal:attributes="
                     href procedure/absolute_url;
                   "
                >
                Title
                </a>
                <div class="procedure-mode p-3 d-flex gap-3 bg-light bg-opacity-50"
                     tal:condition="python:procedure.at_office or procedure.by_phone or procedure.online_url"
                >

                  <span title="At the citizen office"
                        tal:condition="procedure/at_office"
                        tal:replace="structure python:icons.tag('info-circle', tag_class='text-primary fs-5', tag_alt='Do this procedure at the citizen office')"
                  ></span>

                  <span title="By phone"
                        tal:condition="procedure/by_phone"
                        tal:replace="structure python:icons.tag('telephone', tag_class='text-primary fs-5', tag_alt='Do this procedure by phone')"
                  ></span>

                  <span title="Online"
                        tal:condition="procedure/online_url"
                        tal:replace="structure python:icons.tag('globe', tag_class='text-primary fs-5', tag_alt='Do this procedure online')"
                  ></span>

                </div>
              </tal:item>
            </li>

          </ul>
        </div>
      </div>

    </metal:content-core>
  </body>

</html>
